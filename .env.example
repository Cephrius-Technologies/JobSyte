# ---- Supabase (Required) ----
NEXT_PUBLIC_SUPABASE_URL=__INSERT_SUPABASE_URL_HERE__
NEXT_PUBLIC_SUPABASE_ANON_KEY=__INSERT_SUPABASE_ANON_KEY_HERE__

# ---- Supabase Admin (For cron/import scripts) ----
SUPABASE_SERVICE_ROLE_KEY=__INSERT_SERVICE_ROLE_KEY_HERE__

# ---- Email (Resend) ----
RESEND_API_KEY=__INSERT_RESEND_API_KEY_HERE__
RESEND_FROM_EMAIL=__INSERT_FROM_EMAIL_HERE__

# ---- Cron Security ----
CRON_SECRET=__INSERT_CRON_SECRET_HERE__

# ---- App URL ----
NEXT_PUBLIC_APP_URL=__INSERT_APP_URL_HERE__

# ---- Maps (Job/Project locations) ----
# Mapbox renders the interactive job map (/map) and static project map cards.
# Must be public (NEXT_PUBLIC_*) because Mapbox GL runs in the browser.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=__INSERT_MAPBOX_ACCESS_TOKEN_HERE__
# Google Maps Geocoding resolves project addresses to coordinates server-side
# (via /api/maps/geocode). Kept server-only so the key is never exposed.
GOOGLE_MAPS_API_KEY=__INSERT_GOOGLE_MAPS_API_KEY_HERE__

# ---- Weather (Open-Meteo commercial API) ----
# Production forecasts use the customer endpoint and require a commercial API key.
# Local development can use Open-Meteo's public evaluation endpoint without a key.
OPEN_METEO_API_KEY=
